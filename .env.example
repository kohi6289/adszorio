# Copy to .env.local. Without the Supabase values the site runs on built-in sample data (src/data/seed.ts).

# Supabase — public read of the active catalogue (RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only, NEVER expose to the client. Used later for order/lead inserts and admin.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Phase 3: order confirmation + owner notifications)
RESEND_API_KEY=
EMAIL_FROM="Adszorio <orders@adszorio.com>"

# Public base URL used in emails (order links). e.g. https://adszorio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
